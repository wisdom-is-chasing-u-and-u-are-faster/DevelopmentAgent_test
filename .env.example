# -----------------------------------------------------------------------------
# Digital Savings Account Opening Platform - Environment Configuration
# -----------------------------------------------------------------------------

# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Configuration (SQLite for local standalone, PostgreSQL for staging/prod)
DATABASE_URL=sqlite:///./banking_onboarding.db
SQLITE_DB_PATH=banking_onboarding.db
DB_POOL_SIZE=10

# Cache & Message Broker (Optional Redis / Event Bus)
REDIS_URL=redis://localhost:6379/0

# Security & Secrets
JWT_SECRET_KEY=dev-enterprise-banking-jwt-secret-key-change-in-prod
JWT_ALGORITHM=HS256
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# External Service Gateways / Mock Adapters
CBS_BASE_URL=http://localhost:8000/mock/cbs
CMS_BASE_URL=http://localhost:8000/mock/cms
AML_PEP_API_KEY=mock-aml-pep-sanction-key-v1

# Frontend API Base URL
NEXT_PUBLIC_API_URL=http://localhost:8000
