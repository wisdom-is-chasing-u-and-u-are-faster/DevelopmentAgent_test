# Enterprise Ticketing Management System - Environment Variables
PORT=8080
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ticketing_db
REDIS_URL=redis://localhost:6379
OPENSEARCH_URL=http://localhost:9200
PUBSUB_TOPIC=projects/enterprise-itsm/topics/ticket-events
JWT_SECRET=super-secret-enterprise-jwt-key-minimum-32-chars
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00/B00/XXXX
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/XXXX
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=mailer@enterprise.local
SMTP_PASS=localpassword
CLOUD_TASKS_QUEUE=projects/enterprise-itsm/locations/us-central1/queues/sla-milestones
