# Enterprise Ticketing Management System (ETMS) Environment Configuration

# Server Settings
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=info

# Database Connection (Dual-Mode: SQLite fallback for local testing, PostgreSQL for production)
DATABASE_URL=sqlite:///./etms.db

# Notification Integrations (Webhooks & SMTP)
SLACK_WEBHOOK_URL=https://example.com/webhooks/slack
TEAMS_WEBHOOK_URL=https://example.com/webhooks/teams
EMAIL_SMTP_HOST=smtp.mailtrap.io
EMAIL_SMTP_PORT=2525
EMAIL_FROM_ADDRESS=notifications@etms-enterprise.internal

# Security & Concurrency
API_KEY_SECRET=local-dev-placeholder-secret-value
MAX_CONCURRENT_DISPATCHES=50
