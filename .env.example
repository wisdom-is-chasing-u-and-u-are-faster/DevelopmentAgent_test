# Enterprise Ticketing Management System (ETMS) Environment Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Connection (SQLite local fallback / Cloud SQL PostgreSQL HA)
ETMS_DB_FILE=etms.db
DATABASE_URL=sqlite:///./etms.db
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/etms_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Google Cloud Pub/Sub & Cloud Tasks
PUBSUB_TOPIC_TICKETS=projects/enterprise-core/topics/ticket-events
PUBSUB_SUBSCRIPTION_SEARCH=projects/enterprise-core/subscriptions/search-indexer-sub
CLOUD_TASKS_QUEUE_SLA=projects/enterprise-core/locations/us-central1/queues/sla-escalation-queue
CLOUD_TASKS_CALLBACK_BASE_URL=http://localhost:8000/api/v1/sla/callback

# OpenSearch Service
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX=enterprise_tickets
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=admin

# Omnichannel Notifications (Webhooks & Email)
SLACK_WEBHOOK_URL=https://example.com/webhooks/slack
TEAMS_WEBHOOK_URL=https://example.com/webhooks/teams
SENDGRID_API_KEY=sendgrid_api_key_placeholder
EMAIL_FROM_ADDRESS=notifications@enterprise-ticketing.internal

# Security & Session Authentication
JWT_SECRET_KEY=development_secret_key_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ENFORCE_ROW_LEVEL_SECURITY=true

# Frontend Client Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
