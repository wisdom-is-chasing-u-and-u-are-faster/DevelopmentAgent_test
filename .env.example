# ==============================================================================
# Agent Evaluation Platform — 12-Factor Environment Configuration Template
# ==============================================================================

# Server Network Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# Database Connection (SQLite local file or PostgreSQL connection URI)
DATABASE_URL=sqlite:///./eval_platform.db
# For PostgreSQL:
# DATABASE_URL=postgresql://eval_user:eval_password@localhost:5432/eval_db

# Security & Session Secrets (change-me in production)
SECRET_KEY=change-me-eval-platform-secret-key-32chars
